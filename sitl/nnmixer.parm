# NNMixer on ArduRover SITL with the MuJoCo JSON plant
# load with: sim_vehicle.py -v Rover --model JSON:127.0.0.1 --add-param-file sitl/nnmixer.parm

# physics lock-step: one 5 ms MuJoCo step per SITL frame; main loop 200 Hz so the
# gravity filter integrates the gyro at 200 Hz (policy task stays at 50 Hz)
SIM_RATE_HZ 200
SCHED_LOOP_RATE 200

# policy
NNM_ENABLE 1
NNM_POLICY 0
NNM_LOG 1

# 14 joint servos on Scripting1..14 (94..107); wire encoding 1 us = 3 mrad around 1500
SERVO1_FUNCTION 94
SERVO2_FUNCTION 95
SERVO3_FUNCTION 96
SERVO4_FUNCTION 97
SERVO5_FUNCTION 98
SERVO6_FUNCTION 99
SERVO7_FUNCTION 100
SERVO8_FUNCTION 101
SERVO9_FUNCTION 102
SERVO10_FUNCTION 103
SERVO11_FUNCTION 104
SERVO12_FUNCTION 105
SERVO13_FUNCTION 106
SERVO14_FUNCTION 107
SERVO1_MIN 800
SERVO2_MIN 800
SERVO3_MIN 800
SERVO4_MIN 800
SERVO5_MIN 800
SERVO6_MIN 800
SERVO7_MIN 800
SERVO8_MIN 800
SERVO9_MIN 800
SERVO10_MIN 800
SERVO11_MIN 800
SERVO12_MIN 800
SERVO13_MIN 800
SERVO14_MIN 800
SERVO1_MAX 2200
SERVO2_MAX 2200
SERVO3_MAX 2200
SERVO4_MAX 2200
SERVO5_MAX 2200
SERVO6_MAX 2200
SERVO7_MAX 2200
SERVO8_MAX 2200
SERVO9_MAX 2200
SERVO10_MAX 2200
SERVO11_MAX 2200
SERVO12_MAX 2200
SERVO13_MAX 2200
SERVO14_MAX 2200
# Rover's own steering/throttle outputs are not used
SERVO15_FUNCTION 0
SERVO16_FUNCTION 0

# HIL convenience: no GPS/EKF-based arming gates, no RC failsafe action
ARMING_CHECK 0
FS_ACTION 0
FS_THR_ENABLE 0
FS_GCS_ENABLE 0
FS_CRASH_CHECK 0
# BRD_SAFETY_DEFLT 0 so outputs are live once armed
BRD_SAFETY_DEFLT 0

# sticks: full range 1000..2000 so MAVProxy "rc N 1750" is +0.5 of the twist limit
RC1_MIN 1000
RC1_MAX 2000
RC1_DZ 20
RC2_MIN 1000
RC2_MAX 2000
RC2_DZ 20
RC3_MIN 1000
RC3_MAX 2000
RC4_MIN 1000
RC4_MAX 2000
RC4_DZ 20

# IMU filtering: Rover defaults to INS_GYRO_FILTER 4 Hz / INS_ACCEL_FILTER 10 Hz (wheeled vehicle).
# The policy was trained on ~raw gyro at 50 Hz; a 4 Hz LPF adds ~40 ms of lag and the biped falls.
INS_GYRO_FILTER 0
INS_ACCEL_FILTER 20
