.venv/
__pycache__/
*.pyc
sitl/run/*
!sitl/run/.gitkeep
*.onnx
*.BIN
*.bin
!robots/**/robot.bin
!sitl/APM/**/*.bin
!sitl/APM/**/*.nnm
